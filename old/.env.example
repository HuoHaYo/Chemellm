# Keep blank for local development. Required for cloud exposure.
CHEMELLM_AUTH_TOKEN=
CHEMELLM_DATA_DIR=./data
# openai_compatible or ollama; no key is sent to the browser.
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
# Set exact model IDs available in your account. Speed choices map to these IDs.
MODEL_FAST=
MODEL_BALANCED=
MODEL_DEEP=
# Optional vision-capable model ID; blank reuses MODEL_BALANCED and never falls back to another backend.
MODEL_VISION=
# Send reasoning_effort only if the provider/model supports it.
MODEL_REASONING_SUPPORTED=false
# Used only with MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
MODEL_TIMEOUT_SECONDS=120
MAX_AGENT_ITERATIONS=8
CROSSREF_MAILTO=
OPENALEX_API_KEY=
